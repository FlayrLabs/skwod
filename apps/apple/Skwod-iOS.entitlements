<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Universal links: a tapped https://skwod.io/join#… invite opens the app instead of the
	     page. iOS checks https://skwod.io/.well-known/apple-app-site-association (generated by
	     the skwod.io site) for this app's id. The link is validated like any other invite. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:skwod.io</string>
	</array>
	<!-- Shared with the notification service extension (docs/PUSH.md): the encrypted message
	     cache lives in this container… -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(SKWOD_APP_GROUP)</string>
	</array>
	<!-- …and its key + the session token live in this keychain group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(SKWOD_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
