diff --git a/Sources/LiveKit/Core/RTC.swift b/Sources/LiveKit/Core/RTC.swift
index e2b4fede..c592e096 100644
--- a/Sources/LiveKit/Core/RTC.swift
+++ b/Sources/LiveKit/Core/RTC.swift
@@ -109,7 +109,11 @@ extension RTC {
     static func createPeerConnection(_ configuration: LKRTCConfiguration,
                                      constraints: LKRTCMediaConstraints) -> LKRTCPeerConnection?
     {
-        peerConnectionFactory.peerConnection(with: configuration,
+        // Skwod: WebRTC's own option, with its own default (loopback ignored) unless asked.
+        let options = LKRTCPeerConnectionFactoryOptions()
+        options.ignoreLoopbackNetworkAdapter = !LiveKitSDK.gathersLoopback
+        peerConnectionFactory.setOptions(options)
+        return peerConnectionFactory.peerConnection(with: configuration,
                                              constraints: constraints,
                                              delegate: nil)
     }
diff --git a/Sources/LiveKit/LiveKit.swift b/Sources/LiveKit/LiveKit.swift
index a522a0b1..25b5e044 100644
--- a/Sources/LiveKit/LiveKit.swift
+++ b/Sources/LiveKit/LiveKit.swift
@@ -39,8 +39,18 @@ public class LiveKitSDK: NSObject, Loggable {
     fileprivate struct State {
         var logger: any Logger = OSLogger()
         var tracing: any Tracing = LoggingTracer()
+        var gathersLoopback = false
     }
 
+    /// Skwod: peer connections created from now on also gather candidates on this device's loopback
+    /// interface (for a media server that is reached on `127.0.0.1`, through a forwarder in the same
+    /// process). `false` is the SDK's own behaviour.
+    public static func setGathersLoopback(_ on: Bool) {
+        state.mutate { $0.gathersLoopback = on }
+    }
+
+    static var gathersLoopback: Bool { state.gathersLoopback }
+
     fileprivate static let state = StateSync(State())
 
     /// Set a custom ``Tracing`` implementation to capture operation timing.
