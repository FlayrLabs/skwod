+/// Resolutions in progress, and who waits for each.
+type Resolving = HashMap<Box<[String]>, Vec<oneshot::Sender<Vec<SocketAddrV4>>>>;
+static RESOLVING: LazyLock<Mutex<Resolving>> = LazyLock::new(Mutex::default);
