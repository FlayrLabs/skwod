<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11 full-backup rules: exclude everything (allowBackup is false as well). -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
