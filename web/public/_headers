# Cloudflare Pages response headers. The site is the React landing page plus the /join page;
# everything they load (scripts, styles, fonts, images) is a same-origin file built by Vite.
#
# The CSP allows same-origin scripts, styles, images and fonts and nothing else: no inline
# script or style, no third parties, and no fetch/XHR/WebSocket at all (connect-src 'none').
#   - img-src also allows data: for one thing, the film-grain texture in src/index.css, which is
#     an SVG written into the stylesheet as a data: URL.
#   - React sets styles (the staggered entrance delays) through the DOM, not through style=""
#     attributes in HTML, so style-src needs no 'unsafe-inline'.
#   - The fonts are bundled from npm (src/fonts.css), not loaded from Google.
# Opening the app from /join is a top-level navigation to skwod://…, which CSP does not govern
# (there is no shipped navigate-to directive), so 'none' here does not block it.
# Pages adds "Access-Control-Allow-Origin: *" by default; the "!" line removes it.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  ! Access-Control-Allow-Origin
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), gamepad=(), geolocation=(), gyroscope=(), hid=(), idle-detection=(), interest-cohort=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), xr-spatial-tracking=(), clipboard-read=(), clipboard-write=(self)

# Fingerprinted build output never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Invites are read in the browser; keep the page out of indexes and shared caches' histories.
/join
  X-Robots-Tag: noindex
  Cache-Control: no-cache

# Apple fetches this without following redirects and requires JSON. The file has no extension,
# so the type is set here.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600
