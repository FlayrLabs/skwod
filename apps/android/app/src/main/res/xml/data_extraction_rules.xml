<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing in this app may leave the device through Android backup or device-to-device transfer:
  session tokens, the wrapped SQLCipher keys, the encrypted caches and the settings all stay put.
  (allowBackup is false as well; these rules cover Android 12+ where D2D transfer ignores it.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
