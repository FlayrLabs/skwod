<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- E2EE voice/video (LiveKit/WebRTC); the camera also scans invite / device-link QR codes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- App lock: the system's fingerprint / face prompt (with the device passcode as fallback). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Native in-app self-update: download the new apk and launch the system installer for it. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Notifications without Google: there is no FCM and no push gateway on Android. A foreground
      service keeps the connection to the user's own skwod open and raises LOCAL notifications.
      - remoteMessaging: the always-on connection (no daily time limit, may start at boot).
      - phoneCall + microphone + camera: only while a call is in progress.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Required by the phoneCall foreground-service type for a self-managed calling app. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Incoming-call screen over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Doze cuts a foreground service's network too; the user is ASKED (Profile → Notifications). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="Skwod"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Skwod"
        tools:targetApi="35">
        <!--
          The only exported component. Besides the launcher it accepts invite links (skwod://join/… and https://skwod.io/join#…);
          those are untrusted input, validated in Invites.kt, and only ever PREFILL the connect
          screen (nothing is dialed, joined or sent because a link was opened).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Skwod">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="skwod" android:host="join" />
            </intent-filter>
            <!--
              App link: a tapped https://skwod.io/join#… share link opens the app instead of the
              page. Android verifies it against https://skwod.io/.well-known/assetlinks.json
              (generated by the skwod.io site from the release certificate); until that verifies,
              the link just opens the page, which forwards to skwod://. Same untrusted-input rules
              as above. The invite itself is in the fragment, so only the path is matched here.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="skwod.io" android:pathPrefix="/join" />
            </intent-filter>
        </activity>

        <!--
          Incoming-call screen: the only activity that may show over the lock screen, and it shows
          the caller and Answer / Decline only. Not exported; answering dismisses the keyguard
          (the user authenticates) before MainActivity — which never shows when locked — opens.
        -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@style/Theme.Skwod" />

        <service
            android:name=".ConnectionService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
        <service
            android:name=".CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />

        <!-- Restart the connection after a reboot or an app update. Not exported: only the system
             (which may always deliver its protected broadcasts) can reach it. -->
        <receiver android:name=".BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Notification buttons (decline a call, hang up). Explicit intents from this app only. -->
        <receiver android:name=".NotificationActionReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
